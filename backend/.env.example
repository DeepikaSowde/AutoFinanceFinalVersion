PORT=4000

# PostgreSQL connection string. For Neon, use the *pooled* string from the
# console (host contains "-pooler"). Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: maximum connections in the pool (default 10).
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Super admin (product owner) — see "Super admin" in backend/README.md
# ---------------------------------------------------------------------------

# The first super admin, created on start (or with `npm run seed:superadmin`)
# when both are set. An existing account with this email is never changed.
# Password: at least 12 characters.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=Super Admin

# Browser origin(s) of the separate admin app (admin/), comma-separated.
# Only these may call /api/superadmin from a browser. Default for local dev:
# ADMIN_APP_ORIGIN=http://localhost:5174
ADMIN_APP_ORIGIN=

# Optional: how lenders reach you to renew (phone and/or email). Shown in the
# lender app's renewal banner and the "subscription expired" sign-in message.
# SUPPORT_CONTACT=+91 98765 43210
