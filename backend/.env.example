PORT=4000

# PostgreSQL connection string. For Neon, use the *pooled* string from the
# console (host contains "-pooler"). Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: maximum connections in the pool (default 10).
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Super admin (product owner) — see "Super admin" in backend/README.md
# ---------------------------------------------------------------------------

# The first super admin, created on start (or with `npm run seed:superadmin`)
# when both are set. An existing account with this email is never changed.
# Password: at least 12 characters.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=Super Admin
